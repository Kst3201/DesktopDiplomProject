                                <TextBlock Text="Тактовая частота" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding Frequency}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Тактовая частота"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Оценка" Style="{StaticResource ComponentUserPCItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Image Source="{StaticResource Score_Star_Icon}" Height="20" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding TotalScore}" Width="30"
                                         Style="{StaticResource ComponentUserPCItemHeader}" Tag="Оценка"
                                         HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </UniformGrid>
                    </Expander>
                    <Expander Margin="0 5 0 5" DataContext="{Binding VideoCard}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Видеокарта" Style="{StaticResource Header3TextBlockStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <UniformGrid Columns="1" Margin="20 0 0 0">
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Название" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Name}" Tag="Название"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Производитель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Manufacturer}" Tag="Производитель"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Модель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Model}" Tag="Модель"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Графический процессор" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding DataContext.GPUItems, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedItem="{Binding GPU}"
                                          Style="{StaticResource ComboBoxUserPCItemNotEditable}"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Версия PCIexpress" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DataContext.PCIEInterfaceItems, RelativeSource={RelativeSource AncestorType=Page}}" 
                                          Text="{Binding PCIEInterface}"
                                          Style="{StaticResource ComboBoxUserPCItemEditable}"
                                          HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество линий PCIexpress" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountPCIELines}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Количество линий PCIexpress"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Рекомендуемый БП" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding RecommendedBlockPower}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Рекомендуемый БП"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество PIN на доп. питании" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountPinsAdditionalPower}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Количество PIN на доп. питании"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Объём видеопамяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CapacityVideoMemory}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Объём видеопамяти"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Максимальная пропускная способность" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxThroughputCapacity}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Максимальная пропускная способность"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Эффективная частота видеопамяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding MemoryFrequency}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Эффективная частота видеопамяти"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество мониторов" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountMonitors}"
                                         Style="{StaticResource TextBoxUserPCRedactItem}" Tag="Количество мониторов"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Оценка" Style="{StaticResource ComponentUserPCItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Image Source="{StaticResource Score_Star_Icon}" Height="20" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding TotalScore}" Width="30"
                                         Style="{StaticResource ComponentUserPCItemHeader}" Tag="Оценка"
                                         HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </UniformGrid>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
