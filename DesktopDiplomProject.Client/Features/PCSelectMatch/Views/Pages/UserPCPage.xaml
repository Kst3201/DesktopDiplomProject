                                <TextBox Grid.Column="1"
                                         Text="{Binding Size}" Tag="Размер"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сокет" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Socket}" Tag="Сокет"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тип оперативной памяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RAMType}" Tag="Тип оперативной памяти"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество RAM-слотов" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding RAMCountSlots}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество RAM-слотов"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Макисмальный объём RAM" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxRAMValue}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Макисмальный объём RAM"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Максимальная частота RAM" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxRAMFrequency}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Максимальная частота RAM"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Версия PCIexpress" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding PCIEInterface}" Tag="Версия PCIexpress"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество слотов PCIe x16" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountPCIEX16Slots}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество слотов PCIe x16"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество разъёмов M2" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountM2Slots}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество разъёмов M2"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
