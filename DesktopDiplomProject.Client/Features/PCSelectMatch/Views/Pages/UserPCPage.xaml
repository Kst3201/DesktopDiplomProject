<Page x:Class="DesktopDiplomProject.Client.Features.PCSelectMatch.Views.Pages.UserPCPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DesktopDiplomProject.Client.Features.PCSelectMatch.Views.Pages"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded"
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="UserPCPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="5" DataContext="{Binding SourcePC}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Действительный" VerticalAlignment="Center" Style="{StaticResource Header1TextBlockStyle}"
                       HorizontalAlignment="Left" />
                <CheckBox IsChecked="{Binding DataContext.IsSourcePC, RelativeSource={RelativeSource AncestorType=Page}}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <CheckBox.RenderTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                    </CheckBox.RenderTransform>
                </CheckBox>
            </StackPanel>
            <ScrollViewer Grid.Row="1">
                <StackPanel Orientation="Vertical">
                    <Expander Margin="0 5 0 5" DataContext="{Binding CPU}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Цетральный процессор" Style="{StaticResource Header3TextBlockStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <UniformGrid Columns="1" Margin="20 0 0 0">
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Название" Style="{StaticResource ComponentUserPCItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                 Text="{Binding Name}" Tag="Название"
                                 Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Производитель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                 Text="{Binding Manufacturer}" Tag="Производитель"
                                 Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Модель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Model}" Tag="Модель"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сокет" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Socket}" Tag="Сокет"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество ядер" Style="{StaticResource ComponentUserPCItemHeader}"
                    VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountCores}"
                                 Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество ядер"
                                 HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество потоков" Style="{StaticResource ComponentUserPCItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountThreads}"
                                 Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество потоков"
                                 HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Базовая частота" Style="{StaticResource ComponentUserPCItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding BaseFrequency}"
                                 Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Базовая частота"
                                 HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тип оперативной памяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RAMType}" Tag="Тип оперативной памяти"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </UniformGrid>
                    </Expander>

                    <Expander Margin="0 5 0 5" DataContext="{Binding Drive}">
                        <Expander.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Накопитель" Style="{StaticResource Header3TextBlockStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Expander.HeaderTemplate>
                        <UniformGrid Columns="1" Margin="20 0 0 0">
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Название" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Name}" Tag="Название"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Производитель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Manufacturer}" Tag="Производитель"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Модель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Model}" Tag="Модель"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Объем памяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding Capacity}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Объем памяти"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Максимальная скорость передачи данных" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding SpeedDataTransfer}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag=" Максимальная скорость передачи данных"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Интерфейс подключения" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ConnectionInterface}" Tag="Интерфейс подключения"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </UniformGrid>
                    </Expander>
                    <Expander Margin="0 5 0 5" DataContext="{Binding Motherboard}">
