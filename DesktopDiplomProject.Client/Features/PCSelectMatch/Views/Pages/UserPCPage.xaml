                                <TextBox Grid.Column="1"
                                         Text="{Binding Model}" Tag="Модель"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тип оперативной памяти" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding RAMType}" Tag="Тип оперативной памяти"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Объем одного модуля" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding SingleModuleCapacity}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Объем одного модуля"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Количество модулей" Style="{StaticResource ComponentUserPCItemHeader}"
                                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1" Text="{Binding CountModules}"
                                         Style="{StaticResource TextBoxUserPCReadOnlyRedactItem}" Tag="Количество модулей"
                                         HorizontalAlignment="Stretch"/>
                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Тактовая частота" Style="{StaticResource ComponentUserPCItemHeader}"
