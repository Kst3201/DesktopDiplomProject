                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Модель" Style="{StaticResource ComponentUserPCItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                <TextBox Grid.Column="1"
