                            </Grid>
                            <Grid Style="{StaticResource Component_Item_Grid_Style}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Форм-фактор" Style="{StaticResource ComponentUserPCItemHeader}"
