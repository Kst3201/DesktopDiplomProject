<Page x:Class="TestDiplomProject.Views.Components.Pages.CPUsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestDiplomProject.Views.Components.Pages"
      mc:Ignorable="d" 
      d:Background="{StaticResource SurfaceBrush}" Loaded="Page_Loaded"
      d:DesignHeight="720" d:DesignWidth="1280" 
      Title="CPUsPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentType}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid DataContext="{Binding RedactedItem}">
                <UniformGrid Rows="9">
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название" Style="{StaticResource ComponentRedactItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Name}" Tag="Название"
                                 Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Производитель" Style="{StaticResource ComponentRedactItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Manufacturer}" Tag="Производитель"
                                 Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Модель" Style="{StaticResource ComponentRedactItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Model}" Tag="Модель"
                                 Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сокет" Style="{StaticResource ComponentRedactItemHeader}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding DataContext.SocketItems, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Style="{StaticResource ComboBoxRedactedItemEditable}"
                                  Text="{Binding Socket}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Количество ядер" Style="{StaticResource ComponentRedactItemHeader}"
                    VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1" Text="{Binding CountCores}"
                                 Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество ядер"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Количество потоков" Style="{StaticResource ComponentRedactItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1" Text="{Binding CountThreads}"
                                 Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество потоков"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Базовая частота" Style="{StaticResource ComponentRedactItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1" Text="{Binding BaseFrequency}"
                                 Style="{StaticResource TextBoxComponentRedactItem}" Tag="Базовая частота"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Тип оперативной памяти" Style="{StaticResource ComponentRedactItemHeader}"
                    VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding DataContext.RAMTypeItems, RelativeSource={RelativeSource AncestorType=Page}}"
                                  Style="{StaticResource ComboBoxRedactedItemReadOnly}"
                                  SelectedItem="{Binding RAMType}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Цена" Style="{StaticResource ComponentRedactItemHeader}"
                                   VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1" Text="{Binding Price, StringFormat={}{0:F2} ₽}"
                                 Style="{StaticResource TextBoxComponentRedactItem}" Tag="Цена"
                                 HorizontalAlignment="Stretch"/>
                    </Grid>
                </UniformGrid>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding SaveCommand}"/>
                <Button Content="Отменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" ItemsSource="{Binding Items}"
                      d:ItemsSource="{d:SampleData ItemCount=10}" CanUserAddRows="False" CanUserDeleteRows="False"
                      >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Название" Width="3*" MinWidth="150" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ComponentDGItemElement}"/>
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource ComponentDGSubItemElement}"/>
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource ComponentDGSubItemElement}"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Сокет" Width="1*" MinWidth="50" Binding="{Binding Socket}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Header="ЯПЧ" Width="3*" MinWidth="120" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ядра: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountCores}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Потоки: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountThreads}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Частота: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding BaseFrequency}" Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text=" Гц" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Тип ОЗУ" Width="1*" MinWidth="80" Binding="{Binding RAMType}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="Цена" Width="1*" MinWidth="100" Binding="{Binding Price, StringFormat={}{0:F2} ₽}"
                                        HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="Оценка" Width="1*" MinWidth="80" Binding="{Binding TotalScore}"
                                        HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.RedactCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Redact_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Remove_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
            
</Page>
