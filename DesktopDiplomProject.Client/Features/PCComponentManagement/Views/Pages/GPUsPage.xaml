<Page x:Class="TestDiplomProject.Views.Components.Pages.GPUsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestDiplomProject.Views.Components.Pages"
      mc:Ignorable="d" 
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="GPUsPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentTypeName}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <ScrollViewer x:Name="GPUScrollViewer">
                    <UniformGrid Rows="10">
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Name}" Tag="Название"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Производитель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Manufacturer}" Tag="Производитель"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Model}" Tag="Модель"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Штатная частота работы" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding BaseFrequency}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Штатная частота работы"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество универсальных процессоров" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountUniversalProcessors}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество универсальных процессоров"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество текстурных блоков" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountTexturerBlocks}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество текстурных блоков"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество блоков растеризации" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountRasterizationBlocks}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество блоков растеризации"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество RT-ядер" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountRTCores}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество RT-ядер"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество тензорных ядер" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountTensorCores}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество тензорных ядер"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цена" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                                       VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding Price}"
                                     Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Цена"
                                     HorizontalAlignment="Stretch"/>
                        </Grid>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Изменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding ChangeComponent}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding AddComponent}"/>
                <Button Content="Удалить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding RemoveComponent}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" Margin="5" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Width="auto" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Производитель" Width="auto" Binding="{Binding Manufacturer}"/>
                    <DataGridTextColumn Header="Модель" Width="auto" Binding="{Binding Model}"/>
                    <DataGridTextColumn Header="Штатная частота работы" Width="auto" Binding="{Binding BaseFrequency}"/>
                    <DataGridTextColumn Header="Количество универсальных процессоров" Width="auto" Binding="{Binding CountUniversalProcessors}"/>
                    <DataGridTextColumn Header="Количество  текстурных блоков" Width="auto" Binding="{Binding CountTexturerBlocks}"/>
                    <DataGridTextColumn Header="Количество блоков растеризации" Width="auto" Binding="{Binding CountRasterizationBlocks}"/>
                    <DataGridTextColumn Header="Количество RT-ядер" Width="auto" Binding="{Binding CountRTCores}"/>
                    <DataGridTextColumn Header="Количество тензорных ядер" Width="auto" Binding="{Binding CountTensorCores}"/>
                    <DataGridTextColumn Header="Цена" Width="auto" Binding="{Binding Price}"/>
                    <DataGridTextColumn Header="Оценка" Width="auto" Binding="{Binding TotalScore}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
