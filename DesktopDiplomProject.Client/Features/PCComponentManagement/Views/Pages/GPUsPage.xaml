<Page x:Class="TestDiplomProject.Views.Components.Pages.GPUsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestDiplomProject.Views.Components.Pages"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="GPUsPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentType}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <ScrollViewer x:Name="GPUScrollViewer">
                    <UniformGrid Rows="10" DataContext="{Binding RedactedItem}">
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Name}" Tag="Название"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Производитель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Manufacturer}" Tag="Производитель"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Model}" Tag="Модель"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Штатная частота работы" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding BaseFrequency}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Штатная частота работы"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество универсальных процессоров" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountUniversalProcessors}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество универсальных процессоров"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество текстурных блоков" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountTexturerBlocks}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество текстурных блоков"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество блоков растеризации" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountRasterizationBlocks}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество блоков растеризации"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество RT-ядер" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountRTCores}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество RT-ядер"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество тензорных ядер" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountTensorCores}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество тензорных ядер"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding SaveCommand}"/>
                <Button Content="Отменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False"
                      d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding Items}"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Название" Width="3*" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ComponentDGItemElement}"/>
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource ComponentDGSubItemElement}"/>
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource ComponentDGSubItemElement}"/>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Частота" Width="1*" MinWidth="100" Binding="{Binding BaseFrequency}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Header="Количество" Width="3*" MinWidth="120" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="УП: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountUniversalProcessors}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ТБ: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountTexturerBlocks}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="РБ: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountRasterizatoinBlocks}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="РТЯ: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountRTCores}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ТЯ: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountTensorCores}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Оценка" Width="1*" MinWidth="60" Binding="{Binding TotalScore}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.RedactCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Redact_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Remove_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
            
</Page>
