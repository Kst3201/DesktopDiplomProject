<Page x:Class="TestDiplomProject.Views.Components.Pages.MotherboardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestDiplomProject.Views.Components.Pages"
      mc:Ignorable="d"
      Loaded="Page_Loaded"
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="MotherboardsPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentType}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <ScrollViewer x:Name="GPUScrollViewer">
                    <UniformGrid Rows="14" DataContext="{Binding RedactedItem}">
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Name}" Tag="Название"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Производитель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Manufacturer}" Tag="Производитель"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                        Text="{Binding Model}" Tag="Модель"
                        Style="{StaticResource TextBoxComponentRedactItem}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Форм-фактор" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding DataContext.SizeItems, RelativeSource={RelativeSource AncestorType=Page}}"
                                      Text="{Binding Size}"
                                      Style="{StaticResource ComboBoxRedactedItemEditable}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сокет" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding DataContext.SocketItems, RelativeSource={RelativeSource AncestorType=Page}}"
                                      Text="{Binding Socket}"
                                      Style="{StaticResource ComboBoxRedactedItemEditable}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тип оперативной памяти" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                    VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding DataContext.RAMTypeItems, RelativeSource={RelativeSource AncestorType=Page}}" 
                                      SelectedItem="{Binding RAMType}"
                                      Style="{StaticResource ComboBoxRedactedItemReadOnly}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество RAM-слотов" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding RAMCountSlots}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество RAM-слотов"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Макисмальный объём RAM" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxRAMValue}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Макисмальный объём RAM"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Максимальная частота RAM" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxRAMFrequency}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Максимальная частота RAM"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Версия PCIexpress" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                    VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding DataContext.PCIEInterfaceItems, RelativeSource={RelativeSource AncestorType=Page}}" 
                                      Text="{Binding PCIEInterface}"
                                      Style="{StaticResource ComboBoxRedactedItemEditable}"
                                      HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество слотов PCIe x16" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountPCIEX16Slots}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество слотов PCIe x16"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество разъёмов M2" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountM2Slots}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество разъёмов M2"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество разъёмов SATA" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountSATASlots}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Количество разъёмов SATA"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цена" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                        VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding Price, StringFormat={}{0:F2} ₽}"
                        Style="{StaticResource TextBoxComponentRedactItem}" Tag="Цена"
                        HorizontalAlignment="Stretch"/>
                        </Grid>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding SaveCommand}"/>
                <Button Content="Отменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" ItemsSource="{Binding Items}"
                      CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Название" Width="3*" MinWidth="150" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ComponentDGItemElement}"/>
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource ComponentDGSubItemElement}"/>
                                    <TextBlock Text="{Binding Model}" Style="{StaticResource ComponentDGSubItemElement}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ОЗУ" Width="3*" MinWidth="120" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Тип: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding RAMType}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Кол-во слотов: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding RAMCountSlots}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Макс. Объем: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding MaxRAMValue}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Макс. Частота: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding MaxRAMFrequency}" Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text=" Гц" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PCIE" Width="3*" MinWidth="120" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Интерфейс: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding PCIEInterface}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Кол-во x16 слотов: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountPCIEX16Slots}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Накопители" Width="3*" MinWidth="120" HeaderStyle="{StaticResource ComponentDGItemHeader}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Слотов M2: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountM2Slots}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Слотов SATA: " Style="{StaticResource ComponentDGItemElement}"/>
                                        <TextBlock Text="{Binding CountSATASlots}" Style="{StaticResource ComponentDGItemElement}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Цена" Width="1*" MinWidth="100" Binding="{Binding Price, StringFormat={}{0:F2} ₽}"
                                        HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="Оценка" Width="1*" MinWidth="100" Binding="{Binding TotalScore}"
                                        HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Width="auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.RedactCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Redact_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Remove_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
            
</Page>
