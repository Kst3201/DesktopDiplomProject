<Page x:Class="TestDiplomProject.Views.Components.Pages.MotherboardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TestDiplomProject.Views.Components.Pages"
      mc:Ignorable="d" 
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="1200" d:DesignWidth="1280"
      Title="MotherboardsPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentTypeName}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <ScrollViewer x:Name="GPUScrollViewer">
                    <UniformGrid Rows="14">
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Название" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Name}" Tag="Название"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Производитель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Manufacturer}" Tag="Производитель"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Модель" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1"
                             Text="{Binding Model}" Tag="Модель"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Форм-фактор" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" Text="{Binding Sizes}" DisplayMemberPath="Name" SelectedValuePath="ID" SelectedValue="{Binding Size}"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Сокет" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Sockets}"
                          SelectedValue="{Binding Socket}" DisplayMemberPath="Name" SelectedValuePath="ID"
                          HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тип оперативной памяти" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding RAMTypes}" SelectedValue="{Binding RAMType}"
                          DisplayMemberPath="Name" SelectedValuePath="ID"
                          HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество RAM-слотов" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding RAMCountSlots}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество RAM-слотов"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Макисмальный объём RAM" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxRAMValue}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Макисмальный объём RAM"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Максимальная частота RAM" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding MaxRAMFrequency}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Максимальная частота RAM"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Версия PCIexpress" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                           VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PCIEInterfaces}" SelectedValue="{Binding PCIEInterface}"
                          DisplayMemberPath="Name" SelectedValuePath="ID"
                          HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество слотов PCIe x16" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountPCIEX16Slots}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество слотов PCIe x16"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество разъёмов M2" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountM2Slots}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество разъёмов M2"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Количество разъёмов SATA" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding CountSATASlots}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Количество разъёмов SATA"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                        <Grid Style="{StaticResource Component_Item_Grid_Style}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Цена" Style="{StaticResource Component_Item_TBlock_Header_Style}"
                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                            <TextBox Grid.Column="1" Text="{Binding Price}"
                             Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" Tag="Цена"
                             HorizontalAlignment="Stretch"/>
                        </Grid>
                    </UniformGrid>
                </ScrollViewer>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Изменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding ChangeComponent}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Добавить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding AddComponent}"/>
                <Button Content="Удалить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding RemoveComponent}"/>
            </StackPanel>
            <DataGrid Grid.Row="1" Margin="5" ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Width="auto" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Производитель" Width="auto" Binding="{Binding Manufacturer}"/>
                    <DataGridTextColumn Header="Модель" Width="auto" Binding="{Binding Model}"/>
                    <DataGridTextColumn Header="Форм-фактор" Width="auto" Binding="{Binding Size.Name}"/>
                    <DataGridTextColumn Header="Сокет" Width="auto" Binding="{Binding Socket.Name}"/>
                    <DataGridTextColumn Header="Тип оперативной памяти" Width="auto" Binding="{Binding RAMType.Name}"/>
                    <DataGridTextColumn Header="Количество RAM-слотов" Width="auto" Binding="{Binding RAMCountSlots}"/>
                    <DataGridTextColumn Header="Максимальный объем RAM" Width="auto" Binding="{Binding MaxRAMValue}"/>
                    <DataGridTextColumn Header="Максимальная частота RAM" Width="auto" Binding="{Binding MaxRAMFrequency}"/>
                    <DataGridTextColumn Header="Версия PCIexpress" Width="auto" Binding="{Binding PCIEInterface.Name}"/>
                    <DataGridTextColumn Header="Количество слотов PCIe x16" Width="auto" Binding="{Binding CountPCIEX16Slots}"/>
                    <DataGridTextColumn Header="Количество разъемов M2" Width="auto" Binding="{Binding CountM2Slots}"/>
                    <DataGridTextColumn Header="Количество разъемов SATA" Width="auto" Binding="{Binding CountSATASlots}"/>
                    <DataGridTextColumn Header="Цена" Width="auto" Binding="{Binding Price}"/>
                    <DataGridTextColumn Header="Оценка" Width="auto" Binding="{Binding TotalScore}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
