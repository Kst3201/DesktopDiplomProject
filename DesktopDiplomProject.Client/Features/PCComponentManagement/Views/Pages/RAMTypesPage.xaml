<Page x:Class="DesktopDiplomProject.Client.Features.PCComponentManagement.Views.Pages.RAMTypesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DesktopDiplomProject.Client.Features.PCComponentManagement.Views.Pages"
      mc:Ignorable="d" 
      Loaded="Page_Loaded"
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="RAMTypesPage">
    <Page.Resources>
        <ResourceDictionary>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <TextBlock d:Text="Тип комплектующих" Text="{Binding ComponentType}" Style="{StaticResource Header1TextBlockStyle}"/>
        <Grid Grid.Column="0" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <UniformGrid Rows="9" DataContext="{Binding RedactedItem}">
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox Grid.Column="1"
                    Text="{Binding Name}" Tag="Название"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принадлежность к оценке 1" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding ScoreOne}"
                TickFrequency="0.05" TickPlacement="Both"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5"
                />
                        <TextBox Grid.Column="2"
                    Text="{Binding ScoreOne}" Tag="μ(1) %"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принадлежность к оценке 2" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding ScoreTwo}"
                TickFrequency="0.05" TickPlacement="Both"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5"
                />
                        <TextBox Grid.Column="2"
                    Text="{Binding ScoreTwo}" Tag="μ(2) %"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принадлежности к оценке 3" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding ScoreThree}"
                TickFrequency="0.05" TickPlacement="Both"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5"
                />
                        <TextBox Grid.Column="2"
                    Text="{Binding ScoreThree}" Tag="μ(3) %"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принадлежность к оценке 4" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding ScoreFour}"
                TickFrequency="0.05" TickPlacement="Both"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5"
                />
                        <TextBox Grid.Column="2"
                    Text="{Binding ScoreFour}" Tag="μ(4) %"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                    <Grid Style="{StaticResource Component_Item_Grid_Style}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Принадлежность к оценке 5" Style="{StaticResource Component_Item_TBlock_Header_Style}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding ScoreFive}"
                TickFrequency="0.05" TickPlacement="Both"
                VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="5"
                />
                        <TextBox Grid.Column="2"
                    Text="{Binding ScoreFive}" Tag="μ(5) %"
                    Style="{StaticResource PrimaryTextBoxWithPlaceholderStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </UniformGrid>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding SaveCommand}"/>
                <Button Content="Отменить" Style="{StaticResource PrimaryButtonStyle}" Margin="5" Width="100" Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
        <GridSplitter Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="3" Margin="5 0"/>
        <Grid Grid.Column="2" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      d:ItemsSource="{d:SampleData ItemCount=5}"
                      ItemsSource="{Binding Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Width="1*" Binding="{Binding Name}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="μ(1) %" Width="1*" Binding="{Binding ScoreOne}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="μ(2) %" Width="1*" Binding="{Binding ScoreTwo}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="μ(3) %" Width="1*" Binding="{Binding ScoreThree}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="μ(4) %" Width="1*" Binding="{Binding ScoreFour}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTextColumn Header="μ(5) %" Width="1*" Binding="{Binding ScoreFive}" HeaderStyle="{StaticResource ComponentDGItemHeader}" ElementStyle="{StaticResource ComponentDGItemElement}"/>
                    <DataGridTemplateColumn Width="1*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Command="{Binding DataContext.RedactCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Redact_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" HorizontalAlignment="Stretch"
                                            Style="{StaticResource ButtonComponentItem}">
                                        <Button.Content>
                                            <Image Source="{StaticResource Remove_Item_Icon}" Style="{StaticResource ComponentItemImage}"/>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
            
</Page>
