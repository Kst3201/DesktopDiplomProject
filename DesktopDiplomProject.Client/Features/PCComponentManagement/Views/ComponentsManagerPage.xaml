<Page x:Class="DesktopDiplomProject.Client.Features.PCComponentManagement.Views.ComponentsManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DesktopDiplomProject.Client.Features.PCComponentManagement.Views"
      mc:Ignorable="d" 
      d:Background="{StaticResource SurfaceBrush}"
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="ComponentsManagerPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ItemsControl Grid.Column="0" d:ItemsSource="{d:SampleData ItemCount=6}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button d:Content="тип комплектующего" Style="{StaticResource PrimaryButtonStyle}" Margin="10 5 5 5" Command="{Binding OpenComponentPage}"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5" Background="CornflowerBlue" Width="2"/>
        <Frame Grid.Column="2" x:Name="ComponentFrame"
                   NavigationUIVisibility="Hidden"
                   JournalOwnership="OwnsJournal">
        </Frame>
    </Grid>
</Page>
